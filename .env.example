# Port the addon server will listen on
PORT=7000

# Timezone used for kickoff times when a viewer has not chosen one in /configure
TZ=America/New_York

# Public address of this addon, if it is reached through a proxy or tunnel.
# Without it the addon guesses from the request, which is usually right.
# Stremio only loads addons over https, so this is normally an https address.
# ADDON_URL=https://sports.example.com

# --- Sign-in ---------------------------------------------------------------
# First-party web/TV access uses real multi-user accounts. On the first start,
# APP_ADMIN_PASSWORD creates the initial administrator account and is ignored
# forever after an account database exists. APP_ADMIN_USERNAME defaults to admin.
# Use a strong password of at least 10 characters.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
# APP_ADMIN_DISPLAY_NAME=Administrator
# APP_MIN_PASSWORD_LENGTH=10
# APP_SESSION_TTL_MS=2592000000
#
# AUTH_KEY is retained only as a migration fallback. If no accounts exist and a
# valid APP_ADMIN_PASSWORD is not set, a sufficiently strong AUTH_KEY may seed
# the first admin. Once accounts exist, AUTH_KEY is no longer a user login.
AUTH_KEY=
#
# ADMIN_TOKEN remains a separate break-glass/server-dashboard credential. An app
# account with role=admin manages users and global app configuration, but this
# token can still protect low-level cache/server operations independently.
ADMIN_TOKEN=
#
# With no account database and no bootstrap credential the human-facing site is
# LOCKED, not open. Stremio-compatible manifest/catalog/meta/stream endpoints
# remain reachable so server-to-server addon integrations continue to work.

# --- First-party app platform ---------------------------------------------
# These are installation-wide service settings. They are NEVER stored per user
# and are NEVER returned by /api/v1/bootstrap. The first-party web/TV clients
# see only capabilities and use /api/v1/play; they never receive an addon list.
#
# Sports is native to this service and enabled by default. If the first-party
# app is ever pointed at a separately hosted sports manifest, set it here.
# AIOSPORT_MANIFEST_URL=https://sports.example.com/saved/manifest.json
SPORTS_ENABLED=true
#
# Future VOD stack. AIOMetadata owns catalogs/search/meta; AIOStreams owns stream
# discovery, ranking, resolution and automatic failover. VOD stays disabled
# unless BOTH manifest URLs are valid http(s) URLs and VOD_ENABLED=true.
VOD_ENABLED=false
AIOMETADATA_MANIFEST_URL=
AIOSTREAMS_MANIFEST_URL=
#
# Opaque playback sessions keep fallback candidates server-side. A client gets
# one target at a time and asks for the next only after playback failure.
# PLAYBACK_SESSION_TTL_MS=900000
# PLAYBACK_SESSION_LIMIT=1000

# --- Performance -----------------------------------------------------------
# Catalog cards are rendered to JPEG once and cached. They are also rendered
# ahead of time, slowly, so opening a tab does not render hundreds at once.
# This is the pause between cards; raise it to make warming gentler still.
# WARM_GAP_MS=250
#
# How much of one CPU core warming may use on average, 0.05 to 1. The pause
# between cards stretches to keep to it. Default 0.25; lower it on a small host.
# WARM_CPU_SHARE=0.25
#
# Finished cards and fetched logos are kept in DATA_DIR as well as in memory,
# so a restart does not redraw and refetch them all. How much disk each may
# take, in megabytes; the oldest go first.
# CARD_DISK_MB=512
# IMAGE_DISK_MB=256

# --- Advanced ---------------------------------------------------------------
# How long a cached catalog may be served before a background refresh is
# started. Default 600000 (10 minutes).
# CATALOG_REVALIDATE_MS=600000

# Fetch providers one after another instead of together. Slower, but it keeps
# the peak memory down on a very small host.
# LOW_MEMORY_MODE=false

# Port the internal stream resolver listens on. Default 7003.
# RESOLVER_PORT=7003

# Interface to bind to. Default 0.0.0.0, which is every interface. Set to
# 127.0.0.1 to accept only local traffic, e.g. when a reverse proxy is in front.
# HOST=0.0.0.0

# Where saved profiles are kept. Docker Compose sets this to /data, on a volume.
# With plain `docker run`, add -v aiosports-data:/data -e DATA_DIR=/data or they
# are lost on the next rebuild. Default: a data folder beside the code.
# DATA_DIR=/data

# How many saved profiles a server without AUTH_KEY accepts. Default 500.
# PROFILE_LIMIT=500

# Key that signs the stream links this server hands out, so its playlist proxy
# only fetches what it minted. Left unset, one is generated and kept in DATA_DIR.
# LINK_SECRET=

# Per-address request limits on artwork, playlists and embed pages, set far
# above normal use. RATE_LIMIT=off turns them off.
# RATE_LIMIT=on

# Channels with no streams are hidden after two empty checks at least 15
# minutes apart, and come back once they play. 0 shows every channel.
# HIDE_EMPTY_CHANNELS=1

# Some stream hosts refuse anything that is not a browser, so the server
# fetches their video chunks for the player and relays them -- a few hundred
# kilobytes every few seconds per viewer. A host is tried once and relayed only
# if it behaves that way; Streamed's strmd.st is relayed without asking. Name
# other hosts to relay without asking here, comma-separated (they are added to
# strmd.st). "off" relays nothing and tries nothing.
# PROXY_SEGMENT_HOSTS=cdn.example.net

# Cities whose local stations are listed as channels for everyone on this
# server, on top of the cities each profile names in /configure. A state after
# a city says which one: "Knoxville TN". See "Local channels" in the README.
# LOCAL_MARKETS=Chicago, Knoxville TN, Phoenix

# Source sites rotate domains. Each provider already knows the ones its own
# site has lived on and uses whichever answers, so this needs setting only if a
# site moves somewhere newer than this release.
# TOTALSPORTEK_HOSTS=totalsporteki.uno,fifatotalsportek.com

# --- Optional Cloudflare Worker proxy ------------------------------------------
# Send provider requests through your own Cloudflare Worker, for a host whose
# address the sources block. Deploy cloudflare-worker/index.js as a Worker (the
# steps are at the top of that file) and put its URL here. Several workers,
# separated by commas, share the load. Leave unset to fetch directly.
# CF_PROXY_URL=https://aiosports-proxy.yourname.workers.dev

# RESIDENTIAL_PROXY — read by one provider (EmbedIndia) only, and only as a
# flag: setting it to anything makes that provider skip a fallback path. It is
# NOT used as a proxy for outbound requests, despite the URL-shaped format this
# file used to suggest. Leave it blank unless you know you want that.
RESIDENTIAL_PROXY=

# TRUST_PROXY — only needed when a reverse proxy in front of the addon is on a
# public address. A hop count (TRUST_PROXY=1) or a comma-separated list of proxy
# addresses/CIDRs. Left unset, X-Forwarded-For is trusted only from loopback and
# private ranges, which is what a proxy on the same host already is.
# Never set this to "true" on a reachable box: it makes req.ip whatever the
# caller writes in a header, which breaks the per-address sign-in throttle.
TRUST_PROXY=

# --- Extra buffer --------------------------------------------------------------
# LIVE_BUFFER_SECONDS — how far behind the live edge a player starts, beyond the
# three segments it would choose for itself, for viewers who have not picked a
# setting of their own in /configure.
#
# Some sources publish their playlist in bursts rather than steadily: eight
# seconds of nothing, then two segments at once. A player holding twelve seconds
# of video spends most of that on one such pause, and the next slow chunk is a
# stall -- the stream that never breaks but keeps catching itself. With a buffer
# set, the server serves a deeper window of what the source has already
# published and tells the player to start further back in it, so the bursts are
# absorbed. The cost is latency: you see the game that much later.
#
# 0 (the default) plays as close to live as the source allows. 10-30 is a
# sensible range; 120 is the ceiling. A viewer's own choice in /configure always
# wins over this, including their choice of off.
LIVE_BUFFER_SECONDS=0
